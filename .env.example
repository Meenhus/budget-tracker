# Example environment variables for deployment (do NOT commit real secrets)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=anon_key_here
SUPABASE_SERVICE_ROLE_KEY=service_role_key_here
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
APP_URL=https://yourdomain.com

# For local testing with Netlify CLI you can copy to .env and set values.SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_PRO_PRICE_ID=price_your_recurring_price
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
APP_URL=https://your-domain.com
